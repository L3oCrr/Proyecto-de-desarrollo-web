<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o directorio existe físicamente, servirlo directamente.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir el resto de peticiones al front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Forzar respuestas JSON en errores del servidor cuando sea posible.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Evitar listado de directorios.
Options -Indexes
